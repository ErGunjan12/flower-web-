# Sunflower Bloom - Environment Variables Template
# Copy this file to backend/.env

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Security & JWT
SECRET_KEY=sunflower_secret_super_key_2026_nature_bloom_xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./sunflower_bloom.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/sunflower_db

# Shop Administrator Account (Auto-seeded on first run)
ADMIN_EMAIL=admin@sunflowerbloom.com
ADMIN_PASSWORD=SunflowerAdmin@2026
ADMIN_NAME=Sunflower Master Florist

# Payment Gateway (Razorpay Test Mode / Demo Simulation)
RAZORPAY_KEY_ID=rzp_test_SunflowerBloom2026
RAZORPAY_KEY_SECRET=rzp_secret_dummy_test_key_xyz
PAYMENT_MODE=DEMO_TEST

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
